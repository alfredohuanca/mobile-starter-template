{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components": ["./src/components"],
      "@/components/*": ["./src/components/*"],
      "@/screens": ["./src/screens"],
      "@/screens/*": ["./src/screens/*"],
      "@/theme": ["./src/theme"],
      "@/theme/*": ["./src/theme/*"],
      "@/core": ["./src/core"],
      "@/core/*": ["./src/core/*"],
      "@/services": ["./src/services"],
      "@/services/*": ["./src/services/*"],
      "@/navigation": ["./src/navigation"],
      "@/navigation/*": ["./src/navigation/*"],
      "@/utils": ["./src/utils"],
      "@/utils/*": ["./src/utils/*"],
      "@/config": ["./src/config"],
      "@/config/*": ["./src/config/*"]
    }
  }
}
